# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Group chat id (send /chatid in the group to find it). Leave empty on first run.
CHAT_ID=-1001234567890
# Usernames (with or without @) or numeric user ids that are never picked, comma separated
EXCLUDE=boss,@intern,123456789
# Daily pick time and timezone
DUTY_TIME=17:00
TZ=Europe/Moscow
# HTTP API (GET /api/duty). Leave HTTP_ADDR empty to disable.
HTTP_ADDR=:8080
# Required by clients as `Authorization: Bearer <token>` or ?token=. Generate: openssl rand -hex 24
API_TOKEN=change-me
# Where members and today's duty are stored. Docker and systemd set this themselves; only needed for `go run`.
# STATE_PATH=./data/state.json
